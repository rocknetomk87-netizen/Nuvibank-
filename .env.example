# ==================================================
# NUVIBANK CORE - Environment Template
# ==================================================

# Application
APP_NAME=NUVIBANK_CORE
APP_ENV=development
DEBUG=true
PORT=8000

# Security
SECRET_KEY=change_this_secret_key
JWT_SECRET_KEY=change_this_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///nuvibank.db

# PostgreSQL Production Example
# DATABASE_URL=postgresql://user:password@localhost:5432/nuvibank


# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/system.log


# Security Controls
ENABLE_RATE_LIMIT=true
ENABLE_AUDIT_LOG=true
ENABLE_SECURITY_HEADERS=true


# Banking Core
DEFAULT_CURRENCY=AOA
SUPPORTED_CURRENCIES=AOA,USD,EUR


# Ledger
LEDGER_MODE=double_entry
ENABLE_TRANSACTION_HISTORY=true


# Environment Services
REDIS_URL=redis://localhost:6379/0


# Email Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# External APIs
PAYMENT_PROVIDER_API_KEY=
BANKING_API_KEY=


# Monitoring
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true


# Deployment
NODE_ENV=development
